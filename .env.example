# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# The API key lives only here, on the backend. Never in the app (Part A rule 7).

ANTHROPIC_API_KEY=sk-ant-...

# Claude models (read from env so they can be swapped without code changes)
WW_MODEL_MAIN=claude-sonnet-5
WW_MODEL_FAST=claude-haiku-4-5-20251001

# Backend API base (used by scripts / snapshot export). The Expo app uses
# EXPO_PUBLIC_API_BASE separately.
WW_API_BASE=http://localhost:8000

# Real email sending stays OFF unless explicitly enabled (Part A rule 11).
WW_SEND_EMAIL=false
